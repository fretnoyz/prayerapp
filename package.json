{
  "name": "prayerapp",
  "version": "0.2.0",
  "private": true,
  "description": "A simple prayer request list for your phone: capture requests quickly, pray through them daily, and keep a record of how God answered.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "vite build --mode test --outDir dist-test",
    "preview": "vite preview",
    "test": "npm run build:test && node tests/e2e.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fretnoyz/prayerapp.git"
  },
  "homepage": "https://fretnoyz.github.io/prayerapp/",
  "dependencies": {
    "dexie": "^4.4.7",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "fake-indexeddb": "^6.2.8",
    "playwright": "^1.63.0",
    "vite": "^8.3.8"
  }
}
